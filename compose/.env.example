# Copy to compose/.env (git-ignored). Missing required values make `docker compose up` fail.

# --- Required in dev and prod ---
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-long-random-string
# Dev: local.dev (-> compras.local.dev, compras-api.local.dev). Prod: your real domain.
DOMAIN=local.dev

# --- Required in prod only ---
DOCKERHUB_USER=your-dockerhub-user
IMAGE_TAG=1.0.0
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASSWORD=change-me

# --- Optional ---
# Host port for Postgres (bound to 127.0.0.1). Default 5433 so it never clashes with a native Postgres on 5432.
# POSTGRES_HOST_PORT=5433

# --- Only for publish.sh --deploy (run on your machine) ---
# DEPLOY_HOST=ubuntu@your-lightsail-ip
# DEPLOY_DIR=/home/ubuntu/compras/compose

# --- Only for publish.sh (run on your machine) ---
# The production domain baked into the frontend image (DOMAIN above is local.dev in dev).
# PROD_DOMAIN=example.com
